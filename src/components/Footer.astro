---
const sections = [
  { href: '/lessons', label: 'Уроки' },
  { href: '/blog', label: 'Блог' },
  { href: '/prayers', label: 'Молитвы' },
  { href: '/scripture', label: 'Писание' },
];

const info = [
  { href: '/about', label: 'О проекте' },
  { href: '/authors', label: 'Авторы' },
  { href: '/privacy', label: 'Политика конфиденциальности' },
  { href: '/terms', label: 'Условия использования' },
];

const tools = [
  { href: '/quiz', label: 'Тесты' },
  { href: '/diary', label: 'Дневник' },
  { href: '/feedback', label: 'Обратная связь' },
];

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-brand-200/60 bg-brand-100/40 dark:border-brand-800/60 dark:bg-brand-950/60">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <h2 class="font-serif text-lg font-semibold text-brand-900 dark:text-brand-100">О проекте</h2>
        <p class="mt-3 text-sm leading-relaxed text-brand-700 dark:text-brand-300">
          «Школа Молитвы» — открытое собрание уроков, статей и молитвословий, помогающих
          каждому научиться искреннему и регулярному разговору с Богом.
        </p>
      </div>

      <nav aria-label="Разделы сайта">
        <h2 class="font-serif text-lg font-semibold text-brand-900 dark:text-brand-100">Разделы</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {sections.map((item) => (
            <li><a href={item.href} class="text-brand-700 hover:text-accent-600 dark:text-brand-300">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Информационные ссылки">
        <h2 class="font-serif text-lg font-semibold text-brand-900 dark:text-brand-100">Информация</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {info.map((item) => (
            <li><a href={item.href} class="text-brand-700 hover:text-accent-600 dark:text-brand-300">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Инструменты">
        <h2 class="font-serif text-lg font-semibold text-brand-900 dark:text-brand-100">Инструменты</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {tools.map((item) => (
            <li><a href={item.href} class="text-brand-700 hover:text-accent-600 dark:text-brand-300">{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <blockquote class="mt-10 border-l-4 border-accent-400 pl-4 italic text-brand-700 dark:text-brand-300">
      <p>«Непрестанно молитесь. Во всём благодарите; ибо такова о вас воля Божия во Христе Иисусе.»</p>
      <cite class="mt-1 block not-italic text-sm">— 1 Фессалоникийцам 5:17–18</cite>
    </blockquote>

    <div class="mt-10 border-t border-brand-200/60 pt-6 text-sm text-brand-600 dark:border-brand-800/60 dark:text-brand-400">
      <p>© {year} Школа Молитвы. Все материалы доступны для личного изучения и распространения со ссылкой на источник.</p>
    </div>
  </div>
</footer>
