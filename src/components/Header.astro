---
const nav = [
  { href: '/', label: 'Главная' },
  { href: '/lessons', label: 'Уроки' },
  { href: '/blog', label: 'Блог' },
  { href: '/prayers', label: 'Молитвы' },
  { href: '/scripture', label: 'Писание' },
  { href: '/about', label: 'О проекте' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href.replace(/\/+$/, '') || '/') === currentPath;
---

<header class="sticky top-0 z-50 border-b border-brand-200/60 bg-white/80 backdrop-blur dark:border-brand-800/60 dark:bg-brand-950/80">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2 font-serif text-lg font-semibold text-brand-900 dark:text-brand-100">
      <img src="/logo-simple.svg" alt="" width="32" height="32" class="h-8 w-8" />
      <span>Школа Молитвы</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Основная навигация">
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-2 text-sm transition-colors hover:bg-brand-100 hover:text-brand-950 dark:hover:bg-brand-800 dark:hover:text-brand-50',
            isActive(item.href) ? 'font-semibold text-brand-950 dark:text-brand-50' : 'text-brand-700 dark:text-brand-300',
          ]}>{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" onclick="toggleTheme()" aria-label="Переключить тему"
        class="rounded-md p-2 text-brand-700 hover:bg-brand-100 dark:text-brand-300 dark:hover:bg-brand-800">
        <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="block h-5 w-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
      <button type="button" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu"
        class="rounded-md p-2 text-brand-700 md:hidden dark:text-brand-300">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t bg-white px-4 pb-4 md:hidden dark:bg-brand-950">
    <ul class="flex flex-col gap-1 pt-2">
      {nav.map((item) => (
        <li>
          <a href={item.href}
            class:list={[
              'block rounded-md px-3 py-2 text-sm transition-colors',
              isActive(item.href) ? 'bg-brand-100 font-semibold text-brand-950 dark:bg-brand-800 dark:text-brand-50' : 'text-brand-700 dark:text-brand-300',
            ]}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
    menu.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }));
  }
</script>
