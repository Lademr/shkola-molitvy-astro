---
import '../styles/global.css';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: string;
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  description,
  canonical,
  image = '/og-image.svg',
  type = 'website',
  jsonLd = [],
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      jsonLd={jsonLd}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>

  <body class="min-h-screen bg-gradient-to-b from-brand-50 via-white to-accent-50 font-sans text-brand-950 transition-colors dark:from-brand-950 dark:via-brand-900 dark:to-accent-950 dark:text-brand-100">
    <slot />

    <!-- Модальное окно для интерактивных пояснений -->
    <div id="insight-modal" class="insight-modal hidden">
      <div class="insight-modal-backdrop" data-insight-close></div>
      <div class="insight-modal-content">
        <button class="insight-modal-close" data-insight-close aria-label="Закрыть">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
        <div id="insight-modal-body"></div>
      </div>
    </div>

    <script>
      function toggleTheme() {
        const root = document.documentElement;
        const isDark = root.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      }
      (window as unknown as { toggleTheme: () => void }).toggleTheme = toggleTheme;

      // ===== Интерактивные пояснения (всплывающие плашки) =====
      (function () {
        const modal = document.getElementById('insight-modal');
        const body = document.getElementById('insight-modal-body');
        if (!modal || !body) return;

        function openModal(html: string) {
          body!.innerHTML = html;
          modal!.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          modal!.classList.add('hidden');
          body!.innerHTML = '';
          document.body.style.overflow = '';
        }

        document.querySelectorAll('.insight-term').forEach((el) => {
          el.addEventListener('click', () => {
            const id = el.getAttribute('data-insight');
            const template = document.querySelector(`template[data-insight-id="${id}"]`) as HTMLTemplateElement | null;
            if (template) openModal(template.innerHTML);
          });
        });

        modal.querySelectorAll('[data-insight-close]').forEach((el) => {
          el.addEventListener('click', closeModal);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
        });
      })();
    </script>
  </body>
</html>
