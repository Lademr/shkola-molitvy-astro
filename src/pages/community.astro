---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Сообщество — Школа Молитвы"
  description="Сообщество Школы Молитвы."
  canonical="https://shkola-molity.ru/community"
>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl dark:text-brand-50">Сообщество</h1>
    <p class="mt-3 text-brand-700 dark:text-brand-300">Раздел в разработке. Скоро здесь появится общение и обмен опытом.</p>
  </main>
  <Footer />
</BaseLayout>
