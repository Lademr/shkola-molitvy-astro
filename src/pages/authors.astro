---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Плиев Владимир Бексултанович',
    jobTitle: 'Пресвитер',
    url: 'https://shkola-molitvy.ru/authors',
    inLanguage: 'ru',
  },
];
---

<BaseLayout
  title="Авторы — Школа Молитвы"
  description="Команда авторов Школы Молитвы."
  canonical="https://shkola-molitvy.ru/authors"
  jsonLd={jsonLd}
>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl dark:text-brand-50">Авторы</h1>
    <p class="mt-6 text-brand-700 dark:text-brand-300">
      Материалы готовятся командой служителей церкви «Духовное Возрождение» под руководством
      Плиева Владимира Бексултановича.
    </p>
  </main>
  <Footer />
</BaseLayout>
