---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Обратная связь — Школа Молитвы"
  description="Свяжитесь с нами — задайте вопрос или поделитесь свидетельством."
  canonical="https://shkola-molity.ru/feedback"
>
  <Header />
  <main class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl dark:text-brand-50">Обратная связь</h1>
    <p class="mt-3 text-brand-700 dark:text-brand-300">Напишите нам — задайте вопрос, поделитесь свидетельством или предложением.</p>

    <form id="feedback-form" class="mt-8 space-y-4">
      <div>
        <label class="block text-sm font-medium text-brand-800 dark:text-brand-200">Имя *</label>
        <input type="text" id="fb-name" required class="mt-1 w-full rounded-lg border border-brand-300 bg-white p-3 dark:border-brand-700 dark:bg-brand-950" />
      </div>
      <div>
        <label class="block text-sm font-medium text-brand-800 dark:text-brand-200">Email</label>
        <input type="email" id="fb-email" class="mt-1 w-full rounded-lg border border-brand-300 bg-white p-3 dark:border-brand-700 dark:bg-brand-950" />
      </div>
      <div>
        <label class="block text-sm font-medium text-brand-800 dark:text-brand-200">Сообщение *</label>
        <textarea id="fb-message" rows="5" required class="mt-1 w-full rounded-lg border border-brand-300 bg-white p-3 dark:border-brand-700 dark:bg-brand-950"></textarea>
      </div>
      <button type="submit" class="rounded-lg bg-accent-500 px-6 py-3 font-semibold text-white hover:bg-accent-600">Отправить</button>
      <p id="feedback-status" class="mt-3 text-sm"></p>
    </form>
  </main>
  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('feedback-form') as HTMLFormElement;
  const status = document.getElementById('feedback-status')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('fb-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('fb-email') as HTMLInputElement).value.trim();
    const message = (document.getElementById('fb-message') as HTMLTextAreaElement).value.trim();
    if (!name || !message) {
      status.textContent = 'Заполните обязательные поля.';
      status.className = 'mt-3 text-sm text-red-600';
      return;
    }
    const history = JSON.parse(localStorage.getItem('shkola_feedback_history') || '[]');
    history.push({ name, email, message, date: new Date().toISOString() });
    localStorage.setItem('shkola_feedback_history', JSON.stringify(history));
    status.textContent = 'Спасибо! Ваше сообщение отправлено.';
    status.className = 'mt-3 text-sm text-green-600';
    form.reset();
  });
</script>
