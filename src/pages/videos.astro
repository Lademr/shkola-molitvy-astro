---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Видео — Школа Молитвы"
  description="Видеоматериалы Школы Молитвы."
  canonical="https://shkola-molitvy.ru/videos"
>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl dark:text-brand-50">Видео</h1>
    <p class="mt-3 text-brand-700 dark:text-brand-300">Видеоматериалы скоро появятся.</p>
  </main>
  <Footer />
</BaseLayout>
