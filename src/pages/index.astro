---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Школа Молитвы',
    url: 'https://shkola-molity.ru/',
    description: 'Бесплатный интерактивный курс для христиан',
    inLanguage: 'ru',
  },
];

const sections = [
  { icon: '📖', title: 'Уроки', description: '9 уроков от основ до продвинутых практик', href: '/lessons' },
  { icon: '📝', title: 'Блог', description: 'Статьи о молитвенной жизни и духовном росте', href: '/blog' },
  { icon: '🙏', title: 'Молитвы', description: 'Коллекция молитв на разные случаи жизни', href: '/prayers' },
];

const steps = [
  { num: '1', title: 'Уроки', text: 'Пройдите последовательные уроки: от того, как начать молиться, до глубоких практик водительства Духом.' },
  { num: '2', title: 'Практика', text: 'Закрепляйте каждое изучение в ежедневной молитве: используйте примеры молитв и задания уроков.' },
  { num: '3', title: 'Рост', text: 'Отслеживайте прогресс, ведите молитвенный дневник и проверяйте себя тестами и разбором Писания.' },
];
---

<BaseLayout
  title="Школа Молитвы — Интерактивное обучение молитвенной жизни"
  description="Бесплатный интерактивный курс для христиан: уроки молитвы, примеры молитв, разбор Писания, тесты и духовный рост."
  canonical="https://shkola-molity.ru/"
  type="website"
  jsonLd={jsonLd}
>
  <Header />
  <main class="mx-auto max-w-6xl px-4 sm:px-6">
    <section class="py-20 text-center sm:py-28">
      <h1 class="mx-auto max-w-3xl font-serif text-4xl font-bold leading-tight text-brand-950 sm:text-5xl dark:text-brand-50">
        Углуби свою <span class="text-accent-500">молитвенную</span> жизнь
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-brand-700 dark:text-brand-300">
        Интерактивная платформа для тех, кто хочет развивать глубокие отношения с Богом через
        водительство Духом, изучение Слова и духовный рост.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/lessons" class="rounded-lg bg-accent-500 px-6 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-accent-600">
          Начать обучение
        </a>
        <a href="/about" class="rounded-lg border border-brand-300 px-6 py-3 font-semibold text-brand-800 transition-colors hover:bg-brand-100 dark:border-brand-700 dark:text-brand-200 dark:hover:bg-brand-800">
          О проекте
        </a>
      </div>
    </section>

    <section class="pb-20">
      <div class="grid gap-6 sm:grid-cols-3">
        {sections.map((s) => (
          <a href={s.href} class="group rounded-xl border border-brand-200/70 bg-white/70 p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-md dark:border-brand-800 dark:bg-brand-900/60">
            <span class="text-4xl" aria-hidden="true">{s.icon}</span>
            <h3 class="mt-4 font-serif text-xl font-semibold text-brand-950 group-hover:text-accent-600 dark:text-brand-50">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-700 dark:text-brand-300">{s.description}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-accent-600">Перейти →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pb-24">
      <h2 class="text-center font-serif text-3xl font-bold text-brand-950 dark:text-brand-50">С чего начать?</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {steps.map((step) => (
          <div class="rounded-xl border border-brand-200/70 bg-white/70 p-6 text-center dark:border-brand-800 dark:bg-brand-900/60">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-accent-500 text-xl font-bold text-white">{step.num}</div>
            <h3 class="mt-4 font-serif text-lg font-semibold text-brand-950 dark:text-brand-50">Шаг {step.num}: {step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-700 dark:text-brand-300">{step.text}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
