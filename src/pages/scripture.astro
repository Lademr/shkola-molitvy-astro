---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Разбор Писания — Школа Молитвы',
    url: 'https://shkola-molity.ru/scripture',
    inLanguage: 'ru',
  },
];
---

<BaseLayout
  title="Разбор Писания — Школа Молитвы"
  description="Глубокие разборы ключевых текстов Библии о молитве."
  canonical="https://shkola-molity.ru/scripture"
  jsonLd={jsonLd}
>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl dark:text-brand-50">Разбор Писания</h1>
    <p class="mt-3 text-brand-700 dark:text-brand-300">Глубокие разборы ключевых текстов Библии о молитве.</p>
    <p class="mt-8 rounded-lg border border-dashed border-brand-300 p-8 text-center dark:border-brand-700">Разборы Писания скоро появятся.</p>
  </main>
  <Footer />
</BaseLayout>
