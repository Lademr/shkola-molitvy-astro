---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LessonQuiz from '../../components/LessonQuiz.astro';
import { getCollection } from 'astro:content';
import { getQuizByLessonId } from '../../data/quizzes';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => {
    const match = lesson.slug.match(/^(\d+)-(.+)$/);
    const id = match ? match[1] : lesson.slug;
    const name = match ? match[2] : lesson.slug;
    return {
      params: { slug: `${id}/${name}` },
      props: { lesson, id, name },
    };
  });
}

const { lesson, id, name } = Astro.props;
const { Content } = await lesson.render();
const quiz = getQuizByLessonId(id);

const canonical = `https://shkola-molitvy.ru/lessons/${id}/${name}`;

// Основная разметка Course
const courseLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: lesson.data.title,
  description: lesson.data.description,
  provider: { '@type': 'Organization', name: 'Школа Молитвы', url: 'https://shkola-molitvy.ru' },
  url: canonical,
  inLanguage: 'ru',
};

// Собираем FAQ из интерактивных пояснений в уроке
const rawContent = lesson.body || '';
const faqItems: Array<{ '@type': 'Question'; name: string; acceptedAnswer: { '@type': 'Answer'; text: string } }> = [];

const insightRegex = /<script\s+type="text\/html"\s+data-insight-id="([^"]+)"[^>]*>([\s\S]*?)<\/script>/g;
let match: RegExpExecArray | null;

while ((match = insightRegex.exec(rawContent)) !== null) {
  let content = match[2];

  // Убираем SVG и emoji-иконки из начала (первый блок с иконкой и заголовком)
  content = content.replace(/<svg[^>]*>[\s\S]*?<\/svg>/g, '');

  // Извлекаем заголовок (h3 или h2)
  const headingMatch = content.match(/<h[23][^>]*>([\s\S]*?)<\/h[23]>/);
  const question = headingMatch
    ? headingMatch[1].replace(/<[^>]+>/g, '').replace(/[^\p{L}\p{N}\s«»"'’\-—:?!.,]/gu, '').trim()
    : 'Пояснение';

  // Убираем заголовок из тела
  let answer = content.replace(/<h[23][^>]*>[\s\S]*?<\/h[23]>/g, '');

  // Убираем emoji (не они нужны в тексте для поисковика)
  answer = answer.replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\uFE0E\uFE0F\u200D]/gu, '');

  // Заменяем блочные элементы на точку с пробелом
  answer = answer.replace(/<\/(p|li|h[1-6])>/g, '. ');
  answer = answer.replace(/<\/div>/g, ' ');
  answer = answer.replace(/<br\s*\/?>/g, ' ');

  // Убираем остальные HTML-теги
  answer = answer.replace(/<[^>]+>/g, '');

  // Декодируем HTML-сущности
  answer = answer.replace(/&nbsp;/g, ' ')
    .replace(/&laquo;/g, '«').replace(/&raquo;/g, '»')
    .replace(/&quot;/g, '"').replace(/&amp;/g, '&')
    .replace(/&mdash;/g, '—').replace(/&ndash;/g, '–');

  // Убираем множественные пробелы и точки
  answer = answer.replace(/\s*\.\s*\.\s*/g, '. ');
  answer = answer.replace(/\s+/g, ' ').trim();

  // Убираем ведущие точки и пробелы
  answer = answer.replace(/^[\s.]+/, '');

  if (question && answer) {
    faqItems.push({
      '@type': 'Question',
      name: question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: answer.slice(0, 1500),
      },
    });
  }
}

// Собираем итоговый JSON-LD массив
const jsonLd: Record<string, unknown>[] = [courseLd];

if (faqItems.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems,
  });
}
---

<BaseLayout
  title={`${lesson.data.title} — Школа Молитвы`}
  description={lesson.data.description}
  canonical={canonical}
  type="article"
  jsonLd={jsonLd}
  publishedTime={lesson.data.datePublished}
  modifiedTime={lesson.data.dateModified}
  author={lesson.data.author}
>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav class="mb-8 text-sm text-brand-600 dark:text-brand-400">
      <a href="/lessons" class="hover:underline">← Все уроки</a>
    </nav>
    <article class="lesson-content">
      <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl dark:text-brand-50">{lesson.data.title}</h1>
      <p class="text-sm text-brand-600 dark:text-brand-400">{lesson.data.level} · {lesson.data.duration} · {lesson.data.author}</p>
      <Content />
    </article>

    {quiz && <LessonQuiz lessonId={id} quiz={quiz} />}

    <div class="mt-8">
      <a href="/lessons" class="text-brand-600 hover:underline dark:text-brand-400">← Все уроки</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
