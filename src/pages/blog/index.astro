---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime()
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Блог — Школа Молитвы',
    url: 'https://shkola-molity.ru/blog',
    inLanguage: 'ru',
  },
];
---

<BaseLayout
  title="Блог — Школа Молитвы"
  description="Статьи о молитвенной жизни, духовном росте и водительстве Святым Духом."
  canonical="https://shkola-molity.ru/blog"
  jsonLd={jsonLd}
>
  <Header />
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl dark:text-brand-50">Блог</h1>
    <p class="mt-3 max-w-2xl text-brand-700 dark:text-brand-300">Размышления о молитвенной жизни и духовном росте.</p>

    {posts.length === 0 ? (
      <p class="mt-12 rounded-lg border border-dashed border-brand-300 p-8 text-center dark:border-brand-700">Скоро появятся статьи</p>
    ) : (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group flex flex-col rounded-xl border border-brand-200 bg-white/80 p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-brand-800 dark:bg-brand-900/60">
            {post.data.category && (
              <span class="inline-flex w-fit rounded-full bg-accent-100 px-3 py-1 text-xs font-medium text-accent-900 dark:bg-accent-900/60 dark:text-accent-100">{post.data.category}</span>
            )}
            <h2 class="mt-3 font-serif text-xl font-semibold text-brand-950 group-hover:text-accent-700 dark:text-brand-50">{post.data.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-brand-700 dark:text-brand-300">{post.data.description}</p>
            <p class="mt-4 text-xs text-brand-500 dark:text-brand-400">{post.data.author} · {post.data.datePublished}</p>
          </a>
        ))}
      </div>
    )}
  </main>
  <Footer />
</BaseLayout>
