---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Страница не найдена — Школа Молитвы"
  description="Запрашиваемая страница не найдена."
  canonical="https://shkola-molity.ru/404"
>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <h1 class="font-serif text-6xl font-bold text-accent-500">404</h1>
    <h2 class="mt-4 font-serif text-2xl font-semibold text-brand-950 dark:text-brand-50">Страница не найдена</h2>
    <p class="mt-4 text-brand-700 dark:text-brand-300">Извините, такой страницы не существует или она была перемещена.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-lg bg-accent-500 px-6 py-3 font-semibold text-white transition-colors hover:bg-accent-600">
        На главную
      </a>
      <a href="/lessons" class="rounded-lg border border-brand-300 px-6 py-3 font-semibold text-brand-800 transition-colors hover:bg-brand-100 dark:border-brand-700 dark:text-brand-200">
        К урокам
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
