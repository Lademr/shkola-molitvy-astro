---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Молитвенный дневник — Школа Молитвы"
  description="Записывайте молитвы и отслеживайте ответы Бога."
  canonical="https://shkola-molity.ru/diary"
>
  <Header />
  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl dark:text-brand-50">Молитвенный дневник</h1>
    <p class="mt-3 text-brand-700 dark:text-brand-300">Записывайте молитвы и отслеживайте ответы Бога.</p>

    <div class="mt-8 grid grid-cols-3 gap-4">
      <div class="rounded-xl border border-brand-200 bg-white p-4 text-center dark:border-brand-800 dark:bg-brand-900">
        <p id="stat-total" class="text-2xl font-bold text-brand-950 dark:text-brand-50">0</p>
        <p class="text-xs text-brand-500 dark:text-brand-400">Всего</p>
      </div>
      <div class="rounded-xl border border-brand-200 bg-white p-4 text-center dark:border-brand-800 dark:bg-brand-900">
        <p id="stat-answered" class="text-2xl font-bold text-green-600">0</p>
        <p class="text-xs text-brand-500 dark:text-brand-400">Отвечено</p>
      </div>
      <div class="rounded-xl border border-brand-200 bg-white p-4 text-center dark:border-brand-800 dark:bg-brand-900">
        <p id="stat-pending" class="text-2xl font-bold text-accent-600">0</p>
        <p class="text-xs text-brand-500 dark:text-brand-400">В процессе</p>
      </div>
    </div>

    <div class="mt-6 rounded-xl border border-brand-200 bg-white p-5 dark:border-brand-800 dark:bg-brand-900">
      <h3 class="font-semibold text-brand-950 dark:text-brand-50">Новая запись</h3>
      <textarea id="diary-text" rows="3" placeholder="Ваша молитва..." class="mt-3 w-full rounded-lg border border-brand-300 bg-white p-3 text-sm dark:border-brand-700 dark:bg-brand-950"></textarea>
      <select id="diary-category" class="mt-3 w-full rounded-lg border border-brand-300 bg-white p-3 text-sm dark:border-brand-700 dark:bg-brand-950">
        <option value="просьба">Просьба</option>
        <option value="благодарность">Благодарность</option>
        <option value="поклонение">Поклонение</option>
        <option value="исповедание">Исповедание</option>
        <option value="ходатайство">Ходатайство</option>
      </select>
      <button id="diary-add" class="mt-3 rounded-lg bg-accent-500 px-6 py-2 font-semibold text-white hover:bg-accent-600">Добавить запись</button>
    </div>

    <div class="mt-6 flex flex-wrap gap-2">
      <button data-filter="all" class="diary-filter rounded-full border border-brand-300 px-4 py-1 text-sm dark:border-brand-700">Все</button>
      <button data-filter="просьба" class="diary-filter rounded-full border border-brand-300 px-4 py-1 text-sm dark:border-brand-700">Просьба</button>
      <button data-filter="благодарность" class="diary-filter rounded-full border border-brand-300 px-4 py-1 text-sm dark:border-brand-700">Благодарность</button>
      <button data-filter="поклонение" class="diary-filter rounded-full border border-brand-300 px-4 py-1 text-sm dark:border-brand-700">Поклонение</button>
      <button data-filter="исповедание" class="diary-filter rounded-full border border-brand-300 px-4 py-1 text-sm dark:border-brand-700">Исповедание</button>
      <button data-filter="ходатайство" class="diary-filter rounded-full border border-brand-300 px-4 py-1 text-sm dark:border-brand-700">Ходатайство</button>
    </div>

    <div id="diary-list" class="mt-6 space-y-3"></div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const STORAGE_KEY = 'shkola_diary_entries';
  const FILTER_KEY = 'shkola_diary_filter';

  function getEntries() {
    return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
  }
  function saveEntries(entries: any[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(entries));
  }
  function render() {
    const entries = getEntries();
    const filter = localStorage.getItem(FILTER_KEY) || 'all';
    const filtered = filter === 'all' ? entries : entries.filter((e: any) => e.category === filter);
    const list = document.getElementById('diary-list')!;

    if (filtered.length === 0) {
      list.innerHTML = '<p class="rounded-lg border border-dashed border-brand-300 p-8 text-center text-brand-500 dark:border-brand-700">Записей пока нет</p>';
    } else {
      list.innerHTML = filtered.map((e: any) => `
        <div class="rounded-xl border border-brand-200 bg-white p-4 dark:border-brand-800 dark:bg-brand-900">
          <div class="flex items-start justify-between">
            <div>
              <span class="inline-block rounded-full bg-accent-100 px-3 py-1 text-xs font-medium text-accent-900 dark:bg-accent-900/60 dark:text-accent-100">${e.category}</span>
              <p class="mt-2 text-brand-900 dark:text-brand-100">${e.prayer}</p>
              <p class="mt-2 text-xs text-brand-500">${new Date(e.date).toLocaleDateString('ru-RU')} ${e.answered ? '· ✅ Отвечено' : ''}</p>
            </div>
            <button data-id="${e.id}" class="diary-delete text-red-500 hover:text-red-700">🗑</button>
          </div>
        </div>
      `).join('');
      list.querySelectorAll('.diary-delete').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          if (!confirm('Удалить запись?')) return;
          const id = parseInt(btn.dataset.id);
          saveEntries(getEntries().filter((e: any) => e.id !== id));
          render();
        });
      });
    }

    document.getElementById('stat-total')!.textContent = String(entries.length);
    document.getElementById('stat-answered')!.textContent = String(entries.filter((e: any) => e.answered).length);
    document.getElementById('stat-pending')!.textContent = String(entries.filter((e: any) => !e.answered).length);
  }

  document.getElementById('diary-add')!.addEventListener('click', () => {
    const text = (document.getElementById('diary-text') as HTMLTextAreaElement).value.trim();
    const category = (document.getElementById('diary-category') as HTMLSelectElement).value;
    if (!text) return;
    const entries = getEntries();
    entries.unshift({ id: Date.now(), date: new Date().toISOString(), prayer: text, category, answered: false });
    saveEntries(entries);
    (document.getElementById('diary-text') as HTMLTextAreaElement).value = '';
    render();
  });

  document.querySelectorAll('.diary-filter').forEach((btn: any) => {
    btn.addEventListener('click', () => {
      localStorage.setItem(FILTER_KEY, btn.dataset.filter);
      render();
    });
  });

  render();
</script>
